{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIB Browser",
  "version": "1.0.0",
  "identifier": "com.mibbrowser.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MIB Browser",
        "width": 1440,
        "height": 920,
        "minWidth": 1060,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/THIRD-PARTY.txt", "resources/USER-GUIDE.md"],
    "macOS": { "minimumSystemVersion": "13.0" },
    "windows": { "webviewInstallMode": { "type": "offlineInstaller" } },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Browse MIBs and query SNMP devices",
    "longDescription": "A modern cross-platform MIB browser for macOS and Windows."
  }
}
